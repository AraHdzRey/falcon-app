# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git.
NOTICIAS_PORT=3101
NOTICIAS_HOST=127.0.0.1
NOTICIAS_CORS_ORIGIN=http://localhost:8081
# Debe ser EXACTAMENTE el mismo JWT_SECRET de apps/api (minimo 64 caracteres).
# Este valor de ejemplo es intencionalmente invalido (menos de 64 caracteres).
JWT_SECRET=CAMBIAR_POR_EL_JWT_SECRET_REAL_DE_APPS_API
